{
  "name": "leaflet-trails",
  "version": "0.3.1",
  "description": "A Leaflet plugin that allows easy integration with Lonvia's Waymarked Trails Site",
  "main": "leaflet-trails.js",
  "scripts": {
    "build": "esbuild leaflet-trails.js --minify --outfile=leaflet-trails.min.js && esbuild leaflet-trails.css --minify --outfile=leaflet-trails.min.css",
    "dev": "node build/dev.js",
    "test": "npm run build && cucumber-js",
    "preversion": "node -e \"console.error('Versioning is handled by GitHub Actions; do not run npm version locally.'); process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raruto/leaflet-trails.git"
  },
  "keywords": [
    "leaflet",
    "waymarkedtrails",
    "routes",
    "osm"
  ],
  "author": "Raruto",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Raruto/leaflet-trails/issues"
  },
  "homepage": "https://github.com/Raruto/leaflet-trails#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4 || ^2.0.0-beta.3",
    "leaflet-pointable": "^0.2.1"
  }
}
